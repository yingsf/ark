{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/ruff-hook.py\"",
            "timeout": 30,
            "statusMessage": "Formatting changed Python files"
          }
        ]
      }
    ]
  }
}
