name: Python Quality Gate

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv sync
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      # 如项目未启用 pyright，请删除以下步骤
      - run: uv run pyright
      # 如项目未启用 pytest，请删除以下步骤
      - run: uv run pytest
